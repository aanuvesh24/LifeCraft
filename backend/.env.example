# JWT Secret & Auth
SECRET_KEY=lifecraft_super_secret_jwt_key_minecraft_8bit_rpg_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Environment
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
